# Example only — do not commit real secrets. Copy to .env and fill in.
CASCADE_ENV=simulation

# Frontend operator sign-in (HTTP Basic; use HTTPS when hosted).
# Choose a private password before starting the frontend; unset fails closed.
CASCADE_OPERATOR_USERNAME=operator
CASCADE_OPERATOR_PASSWORD=
# Hosted backend access requires the approval token on every non-health route.
# Loopback-only CLI/tests may leave this false.
CASCADE_REQUIRE_AUTH=false

# Backend (python -m backend.api). The approval/backtest endpoints require
# this token; the Next dev server reads it from this file automatically.
CASCADE_APPROVAL_TOKEN=local-demo-only
# Where the Next proxy forwards /v1/* requests (backend bind address).
CASCADE_API_ORIGIN=http://127.0.0.1:8000

# AI mode: set a Google AI Studio key to enable live Gemini/Gemma decisions.
# Without it, AI runs fall back to the deterministic coordinator.
GEMINI_API_KEY=
GEMINI_MODEL=
# Legacy model override is also supported when GEMINI_MODEL is empty.
GEMMA_MODEL=

# Optional gated execution (n8n). Off by default; nothing is ever sent to an
# external service unless ALLOW_SANDBOX_ACTIONS=true AND a webhook URL is set.
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
ALLOW_SANDBOX_ACTIONS=false

# Hosted deployment (Render). The API refuses to bind off-loopback unless
# explicitly opted in; container hosts inject PORT and expect 0.0.0.0.
# CASCADE_HOST=0.0.0.0
# CASCADE_ALLOW_PUBLIC_BIND=true

# Optional receipt-signing key; defaults to the approval token when unset.
CASCADE_RECEIPT_KEY=
# Optional persisted-run directory (default: backend/data/runs).
# CASCADE_DATA_DIR=/var/lib/cascade-zero/runs

# Minimum seconds per tick for interactive simulations (default: 1).
CASCADE_LIVE_TICK_SECONDS=1
